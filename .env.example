# Copy to .env.local and fill in.

# The SOBOS guest ordering host. Production: https://order.soboss.in
# Local dev: the guest-ordering Next app ("guest-ordering" in the workspace
# .claude/launch.json runs it on port 3001; 3000 is the restaurant dashboard).
VITE_SOBOS_ORDER_URL=http://localhost:3001

# This outlet's location id in SOBOS. Order Now opens <order host>/?l=<id>,
# the outlet's counter / take-away menu. A location id is public, not a secret.
VITE_SOBOS_LOCATION_ID=
