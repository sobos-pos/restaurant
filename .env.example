# Copy to .env.local and fill in.

# The SOBOS guest ordering host. The order page loads <this>/v1/sobos-embed.js.
# Production: https://order.sobos.in
# Local dev: the guest-ordering Next app ("guest-ordering" in the workspace
# .claude/launch.json runs it on port 3001).
VITE_SOBOS_ORDER_URL=http://localhost:3001

# This outlet's location id in SOBOS (loc_ + 32 hex). Shown with the code to
# paste on the dashboard: Tables & Floor > Website. Public, not a secret.
VITE_SOBOS_LOCATION_ID=
